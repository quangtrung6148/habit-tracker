# Public Supabase project URL and publishable/legacy anon key only. Never use service_role here.
NEXT_PUBLIC_SUPABASE_URL=https://zqbezrlrijxyealjefsi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key fallback. Leave empty when using a publishable key.
