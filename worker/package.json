{
  "name": "habit-tracker-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.development --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/index.ts",
    "once": "node --env-file-if-exists=.env.development --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/index.ts --once",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/index.js"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
